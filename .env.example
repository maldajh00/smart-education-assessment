# ============================================================
# Smart Education Portal - Environment Variables (example)
# Copy this file to .env and adjust values for your environment.
# NEVER commit the real .env file.
# ============================================================

# --- Application ---
APP_ENV=development
APP_VERSION=1.0.0

# --- Backend / FastAPI ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=smart_education
DATABASE_USER=smart_education
DATABASE_PASSWORD=change_me_in_local_env

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
